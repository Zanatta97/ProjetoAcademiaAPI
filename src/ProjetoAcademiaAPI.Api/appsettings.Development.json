{
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\mssqllocaldb;Database=ProjetoAcademia;Trusted_Connection=True;"
  },
  "Serilog": {
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/projeto-academia-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7
        }
      }
    ]
  },
  "JWT": {
    "ValidAudience": "http://127.0.0.1/12345",
    "ValidIssuer": "https://localhost:7234",
    "SecretKey": "chave-de-desenvolvimento-local-nao-secreta-123",
    "TokenValidityInMinutes": 30,
    "RefreshTokenValidityInMinutes": 60
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:8081" ]
  }
}
