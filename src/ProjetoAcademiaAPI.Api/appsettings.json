{
  "AllowedHosts": "*",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "RateLimiting": {
    "Auth": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    }
  },
  "Auth": {
    "BearerTokenMinutes": 60,
    "RefreshTokenDays": 30
  },
  "ApiLogging": {
    "RetentionDays": 30,
    "MaxBodyLength": 4000,
    "IgnoredPaths": [ "/health", "/openapi", "/scalar" ],
    "BodyExcludedPaths": [ "/api/auth" ]
  }
}